classDiagram

class Library {
    +add_book()
    +register_user()
    +create_loan()
}
class Book {
    +str title
    +str author
    +bool state
    +mark_as_unavailable()
    +mark_as_available()
}

class User {
    +str name
    +str email
}

class Loan {
    +date start_date
    +date end_date
    +close_loan()
}

Library "1" *-- "many" Book
Library "1" *-- "many" User
Book "1" *-- "0..1" Loan
User "1" *-- "0..1" Loan

